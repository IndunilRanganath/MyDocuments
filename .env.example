# Supabase clients run on the server; NEXT_PUBLIC_ prefixes are unnecessary.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# openssl rand -hex 32 — keep stable; server only
APP_AUTH_SECRET=
# Local development only. On Vercel use https://your-app.vercel.app (no trailing slash).
APP_ORIGIN=http://localhost:3000
